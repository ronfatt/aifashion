<svg xmlns="http://www.w3.org/2000/svg" width="800" height="1000" viewBox="0 0 800 1000">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050505" />
      <stop offset="50%" stop-color="#0a0a0a" />
      <stop offset="100%" stop-color="#141414" />
    </linearGradient>
    <radialGradient id="spotlight" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#222222" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>
    <pattern id="cottonTexture" width="6" height="6" patternUnits="userSpaceOnUse">
      <rect width="6" height="6" fill="#111111"/>
      <path d="M 0 3 L 6 3 M 3 0 L 3 6" stroke="#181818" stroke-width="0.8"/>
    </pattern>
  </defs>

  <rect width="100%" height="100%" fill="url(#bgGrad)" />
  <rect width="100%" height="100%" fill="url(#spotlight)" />

  <!-- Garment Floor Shadow -->
  <ellipse cx="400" cy="810" rx="240" ry="25" fill="#000000" opacity="0.8" />

  <!-- Black Garment Silhouette -->
  <g transform="translate(0, 40)">
    <!-- Boxy Sleeveless Silhouette -->
           <path d="M 280 150 L 340 130 L 460 130 L 520 150 L 515 310 L 490 350 L 500 760 L 300 760 L 310 350 L 285 310 Z" fill="url(#cottonTexture)" stroke="#222222" stroke-width="3"/>
           <path d="M 520 150 Q 475 240 515 310" fill="none" stroke="#2a2a2a" stroke-width="5"/>
           <path d="M 280 150 Q 325 240 285 310" fill="none" stroke="#2a2a2a" stroke-width="5"/>

    <!-- Collar Rib -->
    <path d="M 330 130 Q 400 195 470 130" fill="none" stroke="#1c1c1c" stroke-width="14" />
    <path d="M 330 130 Q 400 195 470 130" fill="none" stroke="#2d2d2d" stroke-width="2" stroke-dasharray="4 2"/>

    <!-- Inside Brand Tag -->
    <rect x="365" y="145" width="70" height="26" fill="#080808" stroke="#333" stroke-width="1" rx="1"/>
    <text x="400" y="157" font-family="Bebas Neue, sans-serif" font-size="11" font-weight="bold" fill="#F2EFE8" text-anchor="middle">LOKAL//LOUD</text>
    <text x="400" y="166" font-family="sans-serif" font-size="6" font-weight="bold" fill="#C8FF00" text-anchor="middle">MADE IN MY • 260GSM</text>

    <!-- Front Chest Graphic Print -->
    <g transform="translate(400, 360)">
      <text x="0" y="-10" font-family="Bebas Neue, sans-serif" font-size="54" font-weight="900" fill="#F2EFE8" text-anchor="middle" letter-spacing="3">
        STEADY KONON
      </text>

      <rect x="-140" y="12" width="280" height="26" fill="#080808" stroke="#C8FF00" stroke-width="1" rx="2"/>
      <text x="0" y="29" font-family="sans-serif" font-size="11" font-weight="900" fill="#C8FF00" text-anchor="middle" letter-spacing="2">
        COOL KAT LUAR, PANIC KAT DALAM.
      </text>

      <!-- Micro Batik Corner Accent Motif -->
      <path d="M -150 -50 L -130 -50 M 130 -50 L 150 -50 M -150 50 L -130 50 M 130 50 L 150 50" stroke="#C8FF00" stroke-width="2"/>
      <circle cx="-150" cy="-50" r="2" fill="#C8FF00"/>
      <circle cx="150" cy="-50" r="2" fill="#C8FF00"/>
      <circle cx="-150" cy="50" r="2" fill="#C8FF00"/>
      <circle cx="150" cy="50" r="2" fill="#C8FF00"/>
    </g>

    <!-- Hem Woven Tag -->
    <rect x="290" y="730" width="36" height="20" fill="#080808" stroke="#C8FF00" stroke-width="1"/>
    <text x="308" y="743" font-family="sans-serif" font-size="7" font-weight="extrabold" fill="#C8FF00" text-anchor="middle">🇲🇾 KL</text>
  </g>

  <!-- Editorial Info Footer -->
  <text x="40" y="930" font-family="Bebas Neue, sans-serif" font-size="30" fill="#F2EFE8" letter-spacing="2">STEADY KONON Sleeveless Tee</text>
  <text x="40" y="955" font-family="sans-serif" font-size="12" fill="#8C8C8C" font-weight="500">FRONT VIEW // 260 GSM OVERSIZED BLACK SILHOUETTE</text>
  <rect x="700" y="920" width="60" height="24" fill="#111111" stroke="#C8FF00" stroke-width="1"/>
  <text x="730" y="936" font-family="sans-serif" font-size="10" font-weight="bold" fill="#C8FF00" text-anchor="middle">FRONT</text>
</svg>