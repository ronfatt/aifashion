<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="900" viewBox="0 0 1600 900">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#080808" />
      <stop offset="100%" stop-color="#171717" />
    </linearGradient>
    <linearGradient id="overlay" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#080808" stop-opacity="0.9" />
      <stop offset="60%" stop-color="#080808" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#080808" stop-opacity="0.5" />
    </linearGradient>
    <pattern id="batikGrid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 40 20 L 20 40 L 0 20 Z" fill="none" stroke="#292929" stroke-width="0.8" opacity="0.4"/>
      <circle cx="20" cy="20" r="3" fill="#C8FF00" opacity="0.3"/>
      <path d="M 0 0 L 40 40 M 40 0 L 0 40" stroke="#171717" stroke-width="0.5" opacity="0.3"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bgGrad)" />
  <rect width="100%" height="100%" fill="url(#batikGrid)" />

  <!-- Streetwear Silhouettes / Graphics -->
  <g opacity="0.85">
    <!-- Oversized Tee Silhouette -->
    <path d="M 400 225 L 560 180 L 1040 180 L 1200 225 L 1360 360 L 1200 405 L 1152 720 L 448.00000000000006 720 L 400 405 L 240 360 Z" 
          fill="#111111" stroke="#292929" stroke-width="2"/>
    <!-- Collar -->
    <path d="M 640 180 Q 800 234 960 180" 
          fill="none" stroke="#C8FF00" stroke-width="3" />
    <!-- Graphic Print on Shirt -->
    <rect x="576" y="315" width="448.00000000000006" height="270" fill="#080808" stroke="#292929" rx="4"/>
    <text x="50%" y="405" font-family="Bebas Neue, sans-serif" font-size="96" font-weight="900" fill="#F2EFE8" text-anchor="middle" letter-spacing="2">
      LOKAL//LOUD
    </text>
    <text x="50%" y="468" font-family="sans-serif" font-size="56.00000000000001" font-weight="700" fill="#C8FF00" text-anchor="middle" letter-spacing="1">
      LOOKBOOK 03
    </text>
  </g>

  <!-- Dark Overlay for Editorial Depth -->
  <rect width="100%" height="100%" fill="url(#overlay)" />

  <!-- Badge Top Right -->
  <rect x="1470" y="30" width="100" height="28" fill="#111111" stroke="#C8FF00" stroke-width="1" rx="2"/>
  <text x="1520" y="48" font-family="sans-serif" font-size="11" font-weight="800" fill="#C8FF00" text-anchor="middle">
    MALAYSIA
  </text>

  <!-- Typography -->
  <text x="40" y="810" font-family="Bebas Neue, sans-serif" font-size="128" font-weight="900" fill="#F2EFE8" letter-spacing="2">
    REXKL ALLEYWAY
  </text>
  <text x="40" y="850" font-family="sans-serif" font-size="56.00000000000001" font-weight="500" fill="#8C8C8C">
    Urban Alleyway Attitude
  </text>

  <!-- Accent Line -->
  <line x1="40" y1="865" x2="1560" y2="865" stroke="#292929" stroke-width="1" />
  <rect x="40" y="864" width="60" height="3" fill="#C8FF00" />
</svg>