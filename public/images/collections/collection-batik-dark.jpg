<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="1250" viewBox="0 0 1000 1250">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#080808" />
      <stop offset="100%" stop-color="#171717" />
    </linearGradient>
    <linearGradient id="overlay" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#080808" stop-opacity="0.9" />
      <stop offset="60%" stop-color="#080808" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#080808" stop-opacity="0.5" />
    </linearGradient>
    <pattern id="batikGrid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 40 20 L 20 40 L 0 20 Z" fill="none" stroke="#292929" stroke-width="0.8" opacity="0.4"/>
      <circle cx="20" cy="20" r="3" fill="#C8FF00" opacity="0.3"/>
      <path d="M 0 0 L 40 40 M 40 0 L 0 40" stroke="#171717" stroke-width="0.5" opacity="0.3"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#bgGrad)" />
  <rect width="100%" height="100%" fill="url(#batikGrid)" />

  <!-- Streetwear Silhouettes / Graphics -->
  <g opacity="0.85">
    <!-- Oversized Tee Silhouette -->
    <path d="M 250 312.5 L 350 250 L 650 250 L 750 312.5 L 850 500 L 750 562.5 L 720 1000 L 280 1000 L 250 562.5 L 150 500 Z" 
          fill="#111111" stroke="#292929" stroke-width="2"/>
    <!-- Collar -->
    <path d="M 400 250 Q 500 325 600 250" 
          fill="none" stroke="#C8FF00" stroke-width="3" />
    <!-- Graphic Print on Shirt -->
    <rect x="360" y="437.5" width="280" height="375" fill="#080808" stroke="#292929" rx="4"/>
    <text x="50%" y="562.5" font-family="Bebas Neue, sans-serif" font-size="60" font-weight="900" fill="#F2EFE8" text-anchor="middle" letter-spacing="2">
      LOKAL//LOUD
    </text>
    <text x="50%" y="650" font-family="sans-serif" font-size="35" font-weight="700" fill="#C8FF00" text-anchor="middle" letter-spacing="1">
      COLLECTION 02
    </text>
  </g>

  <!-- Dark Overlay for Editorial Depth -->
  <rect width="100%" height="100%" fill="url(#overlay)" />

  <!-- Badge Top Right -->
  <rect x="870" y="30" width="100" height="28" fill="#111111" stroke="#C8FF00" stroke-width="1" rx="2"/>
  <text x="920" y="48" font-family="sans-serif" font-size="11" font-weight="800" fill="#C8FF00" text-anchor="middle">
    MALAYSIA
  </text>

  <!-- Typography -->
  <text x="40" y="1160" font-family="Bebas Neue, sans-serif" font-size="80" font-weight="900" fill="#F2EFE8" letter-spacing="2">
    BATIK AFTER DARK
  </text>
  <text x="40" y="1200" font-family="sans-serif" font-size="35" font-weight="500" fill="#8C8C8C">
    Warisan lama. Attitude baru.
  </text>

  <!-- Accent Line -->
  <line x1="40" y1="1215" x2="960" y2="1215" stroke="#292929" stroke-width="1" />
  <rect x="40" y="1214" width="60" height="3" fill="#C8FF00" />
</svg>